{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-development-flow:baseline:v1",
  "title": "AI development flow truth-source baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineId",
    "status",
    "createdAt",
    "canonicalSpecSourceId",
    "truthSources",
    "knownConflicts",
    "decisionRegister"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baselineId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["draft", "active", "retired"] },
    "createdAt": { "$ref": "#/$defs/dateTime" },
    "canonicalSpecSourceId": { "$ref": "#/$defs/id" },
    "truthSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "path", "role", "authority", "digest"],
        "properties": {
          "sourceId": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/repoPath" },
          "role": {
            "enum": ["product_content_truth", "owner_confirmed_input", "contract", "reference"]
          },
          "authority": {
            "enum": ["canonical", "authoritative_input", "non_authoritative"]
          },
          "digest": { "$ref": "#/$defs/digest" },
          "description": { "type": "string" }
        }
      }
    },
    "knownConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflictId", "status", "summary", "blockingScopes"],
        "properties": {
          "conflictId": { "$ref": "#/$defs/id" },
          "status": { "enum": ["open", "resolved"] },
          "summary": { "type": "string", "minLength": 1 },
          "blockingScopes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "resolution": { "type": "string", "minLength": 1 },
          "resolvedAt": { "$ref": "#/$defs/dateTime" }
        }
      }
    },
    "decisionRegister": { "$ref": "#/$defs/repoPath" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
    }
  }
}
