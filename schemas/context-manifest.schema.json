{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-development-flow:context-manifest:v2",
  "title": "Minimal task context manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "taskId",
    "baselineId",
    "specDigest",
    "specIndexDigest",
    "taskPacketDigest",
    "controlDigest",
    "subjectContentDigest",
    "subjectRevision",
    "createdAt",
    "items",
    "exclusions",
    "manifestDigest",
    "stageId",
    "taskKind",
    "stageGate"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "manifestId": {
      "$ref": "#/$defs/id"
    },
    "taskId": {
      "$ref": "#/$defs/id"
    },
    "baselineId": {
      "$ref": "#/$defs/id"
    },
    "specDigest": {
      "$ref": "#/$defs/digest"
    },
    "specIndexDigest": {
      "$ref": "#/$defs/digest"
    },
    "taskPacketDigest": {
      "$ref": "#/$defs/digest"
    },
    "controlDigest": {
      "$ref": "#/$defs/digest"
    },
    "subjectContentDigest": {
      "$ref": "#/$defs/digest"
    },
    "subjectRevision": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "$ref": "#/$defs/dateTime"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "digest",
          "reason",
          "required"
        ],
        "properties": {
          "kind": {
            "enum": [
              "spec_excerpt",
              "decision",
              "contract",
              "sensitive_reference",
              "source",
              "diff",
              "finding",
              "other"
            ]
          },
          "path": {
            "$ref": "#/$defs/repoPath"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "startLine": {
            "type": "integer",
            "minimum": 1
          },
          "endLine": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/repoPath"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "stageId": {
      "$ref": "#/$defs/id"
    },
    "taskKind": {
      "enum": [
        "implementation",
        "truth_proposal",
        "evidence_collection",
        "control_plane"
      ]
    },
    "stageGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authorizationBoundary",
        "evidenceRequired"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "blocked",
            "ready",
            "authorized",
            "not_authorized"
          ]
        },
        "authorizationBoundary": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRequired": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
    }
  }
}
