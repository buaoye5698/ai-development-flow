{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-development-flow:spec-index:v2",
  "title": "Compiled specification index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compilerVersion", "baselineId", "provenance", "spec", "sources", "requirements", "acceptanceCases", "decisions", "traceability", "integrity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "baselineId": { "$ref": "#/$defs/id" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "adapter", "frameworkDistribution", "baseRevision"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "path", "digest"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/id" },
            "path": { "$ref": "#/$defs/repoPath" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "exportName", "moduleDigest", "configDigest"],
          "properties": {
            "module": { "$ref": "#/$defs/repoPath" },
            "exportName": { "type": "string", "minLength": 1 },
            "moduleDigest": { "$ref": "#/$defs/digest" },
            "configDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "frameworkDistribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "digest"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "baseRevision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "path", "digest"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/repoPath" },
        "digest": { "$ref": "#/$defs/digest" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "acceptanceCases": { "type": "array", "items": { "$ref": "#/$defs/acceptance" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "traceability": { "type": "array", "items": { "$ref": "#/$defs/trace" } },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "warnings"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "errors": { "type": "array", "items": { "type": "object" } },
        "warnings": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "authority"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "authority": { "enum": ["canonical", "authoritative_input", "non_authoritative"] }, "path": { "$ref": "#/$defs/repoPath" }, "line": { "type": "integer", "minimum": 1 } }
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["id", "strength", "statement"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "strength": { "enum": ["must", "should", "may"] }, "statement": { "type": "string", "minLength": 1 }, "acceptance": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "attributes": { "type": "object" } }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "criteria"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "line": { "type": "integer", "minimum": 1 } }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["id", "question"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "question": { "type": "string", "minLength": 1 }, "suggestedOwner": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
    },
    "trace": {
      "type": "object", "additionalProperties": false, "required": ["requirementId", "sourceIds", "acceptanceIds", "decisionIds"],
      "properties": { "requirementId": { "$ref": "#/$defs/id" }, "sourceIds": { "$ref": "#/$defs/idList" }, "acceptanceIds": { "$ref": "#/$defs/idList" }, "decisionIds": { "$ref": "#/$defs/idList" } }
    }
  }
}
