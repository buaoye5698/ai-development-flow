{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-development-flow:framework-lock:v1",
  "title": "Vendored framework integrity lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frameworkName",
    "frameworkVersion",
    "installMode",
    "distributionDigest",
    "managedFiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "frameworkName": {
      "type": "string",
      "minLength": 1
    },
    "frameworkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "installMode": {
      "const": "vendored"
    },
    "distributionDigest": {
      "$ref": "#/$defs/digest"
    },
    "managedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "ownership",
          "source"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/repoPath"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "ownership": {
            "const": "framework"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
    }
  }
}
