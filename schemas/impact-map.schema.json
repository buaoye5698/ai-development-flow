{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-development-flow:impact-map:v1",
  "title": "Code-to-requirement impact map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mapId", "baselineId", "rules", "globalRequirementIds", "globalVerifierIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mapId": { "$ref": "#/$defs/id" },
    "baselineId": { "$ref": "#/$defs/id" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "pathPatterns", "requirementIds", "acceptanceIds", "verifierIds"],
        "properties": {
          "ruleId": { "$ref": "#/$defs/id" },
          "pathPatterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/scopePattern" }
          },
          "requirementIds": { "$ref": "#/$defs/idList" },
          "acceptanceIds": { "$ref": "#/$defs/idList" },
          "verifierIds": { "$ref": "#/$defs/idList" }
        }
      }
    },
    "globalRequirementIds": { "$ref": "#/$defs/idList" },
    "globalVerifierIds": { "$ref": "#/$defs/idList" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "scopePattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^*?\\[\\]{}\\u0000]+(?:/\\*\\*)?$"
    }
  }
}
